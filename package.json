{
  "name": "dsh-delegation-hub",
  "version": "0.9.0-alpha.1",
  "description": "DSH 委派中枢 / Delegation Hub: one model-division net for every delegated agent — Agency experts, Agent-Teams members, one-shot subagents. Pin the route (provider + model + reasoning effort) without touching the main agent; adds a Settings page (设置 → 委派中枢) that edits the route like the main-agent model picker, plus a team status panel (dsh-team-status). Planned in 0.9: per-role routes, hard-pin against in-session model switches, fallback route on quota/auth failures, catalog preflight.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-team-status": "bin/team-status.mjs",
    "dsh-role-preset": "bin/role-preset.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "delegation",
    "model-division",
    "subagent",
    "llm-route",
    "agent-teams",
    "agency-agents",
    "orchestration"
  ],
  "author": "沈思宏 (https://github.com/tkaiz0406)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkaiz0406/dsh-delegation-hub.git"
  },
  "homepage": "https://github.com/tkaiz0406/dsh-delegation-hub#readme",
  "bugs": {
    "url": "https://github.com/tkaiz0406/dsh-delegation-hub/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/run.mjs && node test/client.mjs",
    "ready": "node test/logs.mjs",
    "verify": "node test/run.mjs && node test/client.mjs && node test/logs.mjs --strict",
    "teams": "node bin/team-status.mjs --serve",
    "teams:once": "node bin/team-status.mjs",
    "pack:tgz": "pnpm pack --pack-destination dist"
  }
}
