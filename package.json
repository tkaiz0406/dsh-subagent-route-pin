{
  "name": "dsh-subagent-route-pin",
  "version": "0.8.23",
  "description": "DSH host+client plugin: pins the LLM route of delegated child agents (Agency experts, Agent-Teams members) without touching the main agent, and adds a Settings page that edits that route like the main-agent model picker.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-team-status": "bin/team-status.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "llm-route",
    "agent-teams",
    "agency-agents"
  ],
  "author": "沈思宏 (https://github.com/tkaiz0406)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkaiz0406/dsh-subagent-route-pin.git"
  },
  "homepage": "https://github.com/tkaiz0406/dsh-subagent-route-pin#readme",
  "bugs": {
    "url": "https://github.com/tkaiz0406/dsh-subagent-route-pin/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "ready": "node test/logs.mjs",
    "verify": "node test/run.mjs && node test/logs.mjs --strict",
    "teams": "node bin/team-status.mjs --serve",
    "teams:once": "node bin/team-status.mjs",
    "pack:tgz": "pnpm pack --pack-destination dist"
  }
}
